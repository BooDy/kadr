#!/bin/sh
set -e

case "$1" in
    configure)
        # Create system user and group
        if ! id -u kadr >/dev/null 2>&1; then
            useradd --system --no-create-home --user-group --shell /usr/sbin/nologin kadr
        fi

        # Setup directories and permissions
        mkdir -p /var/lib/kadr /var/lib/kadr/media /etc/kadr
        chown -R kadr:kadr /var/lib/kadr
        chmod 0750 /var/lib/kadr
        chown root:kadr /etc/kadr/kadr.env /etc/kadr/kadr.toml 2>/dev/null || true
        chmod 0640 /etc/kadr/kadr.env /etc/kadr/kadr.toml 2>/dev/null || true

        # Reload systemd and restart service if active
        if [ -d /run/systemd/system ]; then
            systemctl --system daemon-reload >/dev/null 2>&1 || true
            if systemctl is-active --quiet kadr.service 2>/dev/null; then
                systemctl try-restart kadr.service >/dev/null 2>&1 || true
            fi
        fi
    ;;
esac

exit 0
