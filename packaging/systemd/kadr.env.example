# Kadr Media Server Environment Configuration
# Default path: /etc/kadr/kadr.env

# Network listening address and port
KADR_HOST=0.0.0.0
KADR_PORT=8096

# Server persistent data directory (SQLite DB, cached subtitles, posters)
KADR_DATA_DIR=/var/lib/kadr

# Web client assets directory (HTML5 SPA)
KADR_WEB_DIR=/usr/share/kadr/web

# Optional config file path (TOML)
KADR_CONFIG=/etc/kadr/kadr.toml

# Media directory (can be mounted volume or shared storage)
KADR_MEDIA_DIR=/var/lib/kadr/media

# Logging level (error, warn, info, debug, trace)
RUST_LOG=info,kadr_server=info,kadr_ingest=info
