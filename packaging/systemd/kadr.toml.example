# Kadr Media Server Configuration
# Path: /etc/kadr/kadr.toml

[server]
host = "0.0.0.0"
port = 8492
data_dir = "/var/lib/kadr"
web_dir = "/usr/share/kadr/web"

[storage]
database_path = "/var/lib/kadr/kadr.db"
max_readers = 4

[scanner]
debounce_millis = 500
use_ffprobe = true

# Define libraries to watch and ingest:
